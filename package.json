{
  "name": "vinted-refresh",
  "version": "0.1.0",
  "description": "Re-upload a Vinted listing from a URL and hide the old one",
  "type": "module",
  "bin": {
    "vinted-refresh": "./bin/vinted-refresh.js"
  },
  "scripts": {
    "login": "node bin/vinted-refresh.js login",
    "start": "node bin/vinted-refresh.js",
    "list": "node bin/vinted-refresh.js list",
    "refresh": "node bin/vinted-refresh.js refresh",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  }
}
